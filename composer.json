{
    "name": "kongpda/laravel-attachments-livewire",
    "description": "Blade and Livewire UI for the Kongpda Laravel attachments ecosystem.",
    "keywords": [
        "kongpda",
        "laravel",
        "attachments",
        "livewire"
    ],
    "homepage": "https://github.com/kongpda/laravel-attachments-livewire",
    "license": "MIT",
    "authors": [
        {
            "name": "kongpda",
            "email": "kongpda@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.93.1",
        "illuminate/contracts": "^12.60|^13.10",
        "illuminate/support": "^12.60|^13.10",
        "livewire/livewire": "^3.0|^4.0",
        "kongpda/laravel-attachments-core": "^0.2"
    },
    "suggest": {
        "livewire/flux": "Enables the flux UI driver (ATTACHMENTS_UI_DRIVER=flux)."
    },
    "require-dev": {
        "laravel/pint": "^1.29.1",
        "larastan/larastan": "^3.10",
        "nunomaduro/collision": "^8.9.4",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.7.2",
        "pestphp/pest-plugin-arch": "^4.0.2",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.4",
        "phpstan/phpstan-phpunit": "^2.0.16"
    },
    "autoload": {
        "psr-4": {
            "Kongpda\\LaravelAttachments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kongpda\\LaravelAttachments\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../laravel-attachments-core",
            "options": {
                "symlink": true,
                "versions": {
                    "kongpda/laravel-attachments-core": "0.2.0"
                }
            }
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Kongpda\\LaravelAttachments\\Providers\\AttachmentLivewireServiceProvider"
            ]
        }
    }
}
